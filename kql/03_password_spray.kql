// Purpose: Identify source IPs generating failures across multiple users.
SigninLogs
| where TimeGenerated > ago(24h)
| where ResultType != 0
| summarize
    FailedAttempts = count(),
    TargetedUsers = dcount(UserPrincipalName),
    Users = make_set(UserPrincipalName, 20),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by IPAddress
| where FailedAttempts >= 10
| where TargetedUsers >= 5
| order by TargetedUsers desc, FailedAttempts desc
